# Variables para docker compose. Uso:
#   docker compose --env-file .env.docker up --build
# Valores de EJEMPLO para desarrollo/evaluación: cámbialos en un despliegue real.
# Este archivo se commitea: NO escribas aquí claves reales (Resend, etc.). Las claves
# reales van en .env.docker.local (ignorado por git); ver DOCKER.md, sección "Claves".

# ── Base de datos ──────────────────────────────────
DB_ROOT_PASSWORD=devpass
# El schema.sql crea la BD "muni_stodomingo": si cambias DB_NAME, cambia también el script.
DB_NAME=muni_stodomingo
DB_USER=muniapp
DB_PASSWORD=munipass
DB_EXTERNAL_PORT=3307

# ── JWT ────────────────────────────────────────────
# Mínimo 32 caracteres y sin la palabra "cambiar" (el backend lo valida al arrancar).
JWT_SECRET=clave_super_segura_de_produccion_con_mas_de_32_chars
JWT_EXPIRES_IN=24h

# ── Email (Resend) — opcional ──────────────────────
# Lo usan el 2FA por correo, la recuperación de contraseña y los avisos de estado.
# Vacío = dry run: los correos (con el código de 6 dígitos del 2FA) salen en los logs
# del backend: docker compose logs -f backend
RESEND_API_KEY=
EMAIL_FROM=MuniStoDomingo <onboarding@resend.dev>
# Con el remitente de prueba onboarding@resend.dev, Resend solo entrega al correo del
# dueño de la cuenta: pon aquí ese correo para que TODOS los mensajes lleguen a él.
# Déjalo vacío con un dominio propio verificado.
EMAIL_REDIRECT_TO=
# Solo demos sin Resend: 1 imprime el enlace completo de recuperación en los logs.
MOSTRAR_TOKEN_RECUPERACION=0

# ── Límites (opcionales; estos son los valores por defecto del backend) ──
# AUTH_RATE_LIMIT_MAX=10          # intentos de autenticación por IP cada 15 min
# GENERAL_RATE_LIMIT_MAX=100      # peticiones por IP y minuto (súbelo si corres el suite E2E)
# UPLOAD_RATE_LIMIT_MAX=20        # archivos subidos por IP cada 10 min
# CUOTA_DOCUMENTOS_MB=50          # espacio total de adjuntos por vecino
# MAX_SOLICITUDES_ABIERTAS=20     # solicitudes abiertas por vecino

# ── Puertos expuestos al host ──────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=8080
