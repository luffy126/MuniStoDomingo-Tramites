# Variables para docker compose. Uso:
#   docker compose --env-file .env.docker up --build
# Valores de EJEMPLO para desarrollo/evaluación: cámbialos en un despliegue real.

# ── Base de datos ──────────────────────────────────
DB_ROOT_PASSWORD=devpass
# El schema.sql crea la BD "muni_stodomingo": si cambias DB_NAME, cambia también el script.
DB_NAME=muni_stodomingo
DB_USER=muniapp
DB_PASSWORD=munipass
DB_EXTERNAL_PORT=3307

# ── JWT ────────────────────────────────────────────
# Mínimo 32 caracteres y sin la palabra "cambiar" (el backend lo valida al arrancar).
JWT_SECRET=clave_super_segura_de_produccion_con_mas_de_32_chars
JWT_EXPIRES_IN=24h

# ── Email (Resend) — opcional ──────────────────────
# Vacío = dry run: los emails se muestran en los logs del backend.
RESEND_API_KEY=
EMAIL_FROM=MuniStoDomingo <onboarding@resend.dev>

# ── Puertos expuestos al host ──────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=8080
