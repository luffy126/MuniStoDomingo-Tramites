# ── Base de datos ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=muni_stodomingo

# ── JWT ────────────────────────────────────────────
# El servidor no arranca si el secreto tiene menos de 32 caracteres o contiene "cambiar".
JWT_SECRET=cambiar_por_un_string_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=24h

# ── Servidor ───────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────
# Origen del frontend: Vite (npm run dev) usa :5173; con `ionic serve` va http://localhost:8100
FRONTEND_URL=http://localhost:5173
