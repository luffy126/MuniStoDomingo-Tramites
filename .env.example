# ── Base de datos ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=muni_stodomingo

# ── JWT ────────────────────────────────────────────
# El servidor no arranca si el secreto tiene menos de 32 caracteres o contiene "cambiar".
JWT_SECRET=cambiar_por_un_string_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=24h

# ── Servidor ───────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────
# Origen del frontend: Vite (npm run dev) usa :5173; con `ionic serve` va http://localhost:8100
FRONTEND_URL=http://localhost:5173

# ── Proxy reverso ──────────────────────────────────
# Solo detrás de Nginx/Docker: número de proxies de confianza (deja vacío en desarrollo local).
# TRUST_PROXY=1

# ── Servicio de email (Resend) ─────────────────────
# Clave en https://resend.com/api-keys. Sin clave (o con este valor de ejemplo) los
# correos solo se registran en la consola del servidor (dry run) y nada se envía.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente. onboarding@resend.dev funciona sin verificar dominio, pero con él Resend
# SOLO entrega al correo del dueño de la cuenta; para escribir a cualquier vecino hay
# que verificar un dominio propio en https://resend.com/domains.
EMAIL_FROM=MuniStoDomingo <onboarding@resend.dev>
# Opcional: desvía TODOS los correos a esta casilla (el asunto indica el destinatario
# original). Úsalo en demos con el remitente de prueba, poniendo el correo de tu cuenta
# de Resend. Déjalo vacío en producción.
# EMAIL_REDIRECT_TO=tu_correo@ejemplo.cl
